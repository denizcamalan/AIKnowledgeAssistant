  },
  "Cors": {
    "Origins": [ "http://localhost:5173" ]
  },
  "DocumentStorage": {
    "RootPath": "uploads",
    "MaxFileSizeBytes": 10485760,
    "AllowedExtensions": [ ".pdf", ".txt" ]
  }
}
