{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Api": {
    "DisplayName": "AI Knowledge Assistant"
  },
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Jwt": {
    "Issuer": "AIKnowledgeAssistant",
    "Audience": "AIKnowledgeAssistant.Api",
    "SigningKey": "CHANGE_ME_use_user_secrets_or_env_min_32_chars",
